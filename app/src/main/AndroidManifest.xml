<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Star App Sencilla lee aquí las menciones: solo apps firmadas con la misma clave y con el permiso -->
    <uses-permission android:name="com.example.autoclick.LEER_MENCIONES" />
    <uses-permission android:name="com.example.autoclick.historias.LEER_MENCIONES" />
    <queries>
        <provider android:authorities="com.example.autoclick.menciones" />
        <provider android:authorities="com.example.autoclick.historias.menciones" />
    </queries>

    <permission
        android:name="${applicationId}.LEER_MENCIONES"
        android:protectionLevel="signature" />

    <application
        android:label="${appLabel}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/StarTheme">

        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CommentActivity"
            android:exported="false"
            android:label="Comentarios automáticos" />
        <activity
            android:name=".EtiquetadorActivity"
            android:exported="false"
            android:label="Etiquetador de sorteos"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ComprobarActivity"
            android:exported="false"
            android:label="Comprobador de comentarios"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SencillaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <service
            android:name=".ClickService"
            android:exported="false"
            android:label="${appLabel}"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <!-- Las menciones de esta app: solo las lee Star App Sencilla (misma firma y permiso) -->
        <provider
            android:name=".MencionesProvider"
            android:authorities="${applicationId}.menciones"
            android:exported="true"
            android:readPermission="${applicationId}.LEER_MENCIONES" />
    </application>
</manifest>
